# Copy this template to .env and edit the ignored local copy.
# Never put real credential values in this template.
# Load explicitly with load_env_file(".env") or llgm ask --env-file .env.
# Existing exported variables take precedence, including empty values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLGM_WORKSPACE_PATH=./memory
LLGM_BLOB_BACKEND=local
LLGM_METADATA_BACKEND=sqlite
LLGM_RETRIEVER_BACKEND=sqlite_fts5
LLGM_ROOT_PROVIDER=openai
LLGM_ROOT_MODEL=your-root-model-id
LLGM_SIDECAR_PROVIDER=openai
LLGM_SIDECAR_MODEL=your-sidecar-model-id
LLGM_MAX_SEED_NODES=3
LLGM_RETRIEVAL_K=12
LLGM_MAX_CONCURRENCY=3
LLGM_MAX_JOURNAL_BYTES=65536
LLGM_NODE_REPL_IMAGE=python:3.12-slim
LLGM_MAX_MODEL_CALLS=40
LLGM_MAX_SIDECAR_CALLS=36
LLGM_MAX_SEARCHES=8
LLGM_MAX_EVIDENCE_TOKENS=65536
LLGM_MAX_BUNDLE_TOKENS=8000
LLGM_MAX_CONTEXT_TOKENS=65536
LLGM_MAX_OUTPUT_TOKENS=2048
LLGM_TIMEOUT_SECONDS=120
