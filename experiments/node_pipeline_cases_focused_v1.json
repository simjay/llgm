{
  "schema_version": 1,
  "description": "Focused synthetic development cohort frozen before execution. Twelve autonomous paired cases and five separately labelled LLGM-only controlled mechanism cases. Expected values, labels and mechanism requirements are evaluator-only. Guided recursion prescribes a mechanism without prescribing answers. Fault modes are explicit single-trial transport interventions; they do not establish autonomous recovery or budget planning without their trace. Edge publication order is not callback order; relation_order alone guarantees lexical relation presentation. No case is held-out benchmark evidence.",
  "cases": [
    {
      "id": "focus-v1-01-edge-choice",
      "category": "edge_relation_choice",
      "question": "Which credential authorizes Nettle release? Give only the credential.",
      "scope": {},
      "nodes": [
        {
          "label": "entry",
          "text": "Nettle release authorization is in its attached credential record. The other attachment is incident personnel, not authorization."
        },
        {
          "label": "contact",
          "text": "Duty contact: CIRRUS."
        },
        {
          "label": "credential",
          "text": "LAPIS."
        }
      ],
      "edges": [
        {
          "source": "entry",
          "target": "contact",
          "relation": "contact_for_incidents"
        },
        {
          "source": "entry",
          "target": "credential",
          "relation": "deployment_authorization"
        }
      ],
      "patches": [],
      "expected": {
        "answer_contains_all": [
          "LAPIS"
        ],
        "answer_excludes": [
          "CIRRUS"
        ],
        "evidence_labels": [
          "credential"
        ],
        "abstention": false,
        "mechanism_requirements": {
          "note": "Use the observed edge order; publication order is not a deterministic callback order. Correct target selection must follow the relation meaning."
        }
      }
    },
